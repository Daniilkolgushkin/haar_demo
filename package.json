{
  "name": "haar-audio-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm:build": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm:build && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run wasm:build && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:core": "bash scripts/test-core.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
